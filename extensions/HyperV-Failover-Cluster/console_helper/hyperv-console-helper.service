[Unit]
Description=Hyper-V console helper for CloudStack (VMConnect RDP served as VNC)
After=network-online.target

[Service]
User=hvconsole
Group=hvconsole
SupplementaryGroups=cloud
RuntimeDirectory=hyperv-console
# The management server (user cloud) must reach the socket; the socket itself is 0660 hvconsole:cloud.
RuntimeDirectoryMode=0751
StateDirectory=hyperv-console
Environment=HOME=/var/lib/hyperv-console
ExecStart=/usr/bin/python3 /usr/local/lib/hyperv-console/hyperv_console_helper.py --config /etc/hyperv-console-helper.json
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/hyperv-console

[Install]
WantedBy=multi-user.target
